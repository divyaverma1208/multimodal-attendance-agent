[Unit]
Description=Classroom Intelligence Agent - Multimodal Attendance & Engagement
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/multimodal-attendance-agent
ExecStart=/home/ubuntu/multimodal-attendance-agent/.venv/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1 --server.headless=true
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
